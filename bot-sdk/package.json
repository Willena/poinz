{
  "name": "poinz-sdk",
  "version": "0.20.3",
  "description": "Distributed Planning Poker",
  "private": true,
  "author": "xeronimus@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/Zuehlke/poinz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zuehlke/poinz.git"
  },
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest ",
    "pretest": "npm run lint",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"migrations/**/*.js\" \"./*js\"",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"migrations/**/*.js\" \"./*js\"",
    "start": "node src/server.js"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/test/unit/setup.js"
    ],
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/test/**/*Test.js"
    ]
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "fastq": "1.15.0",
    "jira-client": "^8.2.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "6.1.0",
    "nanoid": "5.0.1",
    "papaparse": "5.4.1",
    "rate-limiter-flexible": "^3.0.0",
    "socket.io-client": "4.7.2",
    "tv4": "1.3.0",
    "uuid": "^13.0.0",
    "winston": "3.11.0",
    "winston-daily-rotate-file": "4.7.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.1.0",
    "eslint": "8.51.0",
    "jest": "29.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
